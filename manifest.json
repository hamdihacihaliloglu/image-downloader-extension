{
    "manifest_version": 2,
    "name": "Image Downloader",
    "version": "0.0.2",
    "description": "Easily detect, download, convert (SVG to PNG, PNG to SVG), and resize images from any website.",
    "permissions": [
      "activeTab",
      "downloads",
      "tabs",
      "<all_urls>"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "image-downloader@phoenixmantis.com",
        "strict_min_version": "58.0"
      }
    },
    "browser_action": {
      "default_popup": "popup.html"
    },
    "icons": {
      "16": "icons/icon16x16.png",
      "32": "icons/icon32x32.png",
      "48": "icons/icon48x48.png",
      "128": "icons/icon128x128.png"
    }
  }